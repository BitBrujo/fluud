#!/bin/sh
# Run the whole test suite. One command before a deploy.
#
#     ./scripts/check          # everything that needs no database
#     ./scripts/check --db     # adds the Tier 4 seam checks (not built yet)
#
# Individual scripts stay runnable on their own, because `CLAUDE.md`'s "run this
# after touching that" guidance depends on it. This only adds a single entry
# point; it is not the way to run one contract.
#
# ⚠️ **`set -e` is deliberately OFF.** Every check script accumulates its own
# failures and reports them all rather than stopping at the first, and this
# follows the same rule one level up: a runner that stops at the first red script
# hides how much moved. It collects, prints a summary, and exits non-zero if
# anything failed.
#
# ⚠️ **A missing `web/node_modules` is a SKIP, not a failure.** A fresh clone has
# no UI until someone runs `npm ci`, and the Python contract scripts are exactly
# what you want runnable in that state.

cd "$(dirname "$0")/.." || exit 2

# ⚠️ `check_mail.py` imports `waterline.mail`, which imports `waterline.db`,
# which imports `psycopg` — installed, never connected to. So the suite needs the
# project's dependencies even though nothing here opens a socket. Prefer the
# venv; fall back to whatever `python3` is and let the import error say why.
if [ -x .venv/bin/python ]; then
  PY=.venv/bin/python
else
  PY=python3
fi

PASS=0
FAIL=0
SKIP=0
FAILED=""

run() {
  name="$1"
  shift
  out=$("$@" 2>&1)
  if [ $? -eq 0 ]; then
    PASS=$((PASS + 1))
    printf '  ok    %s\n' "$name"
  else
    FAIL=$((FAIL + 1))
    FAILED="$FAILED $name"
    printf '  FAIL  %s\n' "$name"
    printf '%s\n' "$out" | sed 's/^/          /'
  fi
}

skip() {
  SKIP=$((SKIP + 1))
  printf '  skip  %s — %s\n' "$1" "$2"
}

printf '\nthe safety contracts (%s)\n' "$PY"
# ⚠️ `check_escalation.py` runs FIRST and stays the control: every other script
# here is allowed to change, and this one passing unchanged is the evidence that
# `escalation.py` and the copy were not touched.
run "escalation" "$PY" scripts/check_escalation.py
run "watch" "$PY" scripts/check_watch.py
run "notify" "$PY" scripts/check_notify.py
run "ingest" "$PY" scripts/check_ingest.py
run "models" "$PY" scripts/check_models.py
run "mail" "$PY" scripts/check_mail.py
run "rat" "$PY" scripts/check_rat.py
run "neon" "$PY" scripts/check_neon.py

printf '\nthe web lib\n'
if [ ! -d web/node_modules ]; then
  skip "vitest" "web/node_modules is absent — run: cd web && npm ci"
  skip "parity" "needs vitest"
else
  # `npm test` covers the pure lib AND the cross-language parity check, which is
  # the one that can see a constant drifting between Python and TypeScript.
  run "vitest" sh -c 'cd web && npm test --silent'
fi

if [ "$1" = "--db" ]; then
  printf '\nthe seams (Postgres)\n'
  # Tier 4 of docs/plans/test-suite.md. Not built yet, and saying so is the
  # point: a runner that silently runs nothing for a flag somebody passed is a
  # runner that reports a green suite for an unchecked tier.
  skip "routes" "not built — see docs/plans/test-suite.md, Tier 4"
  skip "watch flow" "not built — see docs/plans/test-suite.md, Tier 4"
  skip "outbox drain" "not built — see docs/plans/test-suite.md, Tier 4"
fi

printf '\n%d passed, %d failed, %d skipped\n' "$PASS" "$FAIL" "$SKIP"
if [ "$FAIL" -ne 0 ]; then
  printf 'failed:%s\n\n' "$FAILED"
  exit 1
fi
printf '\n'
