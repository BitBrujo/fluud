# ---- database (Neon works out of the box) ----
#
# ⚠️ POINT THIS AT A BRANCH, NEVER AT THE DEPLOYED DATABASE. `POLL_IN_SERVICE`
# defaults on in a dev `.env`, so this process WRITES: readings every minute,
# subscriber rows for anything you subscribe, and — with `MAIL_TRANSPORT=smtp`
# below — real email, sent as the product.
#
# Two failures came out of exactly that on 2026-08-16, neither of them visible
# to any check script:
#
#   · A confirmation reached a real inbox with `http://127.0.0.1:8081` links,
#     because `outbox.body` is stored AS RENDERED and carries the
#     `PUBLIC_BASE_URL` of whichever process QUEUED it. The links resolved
#     perfectly for the person running the server and for nobody else.
#   · `/api/healthz`'s `writes` block stopped naming a process. `poll_ticks` is
#     one upserted row per `mode`; two loops in the same mode overwrite each
#     other, so it survives the loop and the API being SEPARATE processes and
#     not their being DUPLICATE ones. It misled a post-deploy check that day.
#
# On Neon a branch is a copy-on-write fork, so it arrives with the schema and
# the registry already in it and `poll bootstrap` is not needed.
DATABASE_URL=postgresql://user:pass@host/waterline?sslmode=require

# ---- Neon Auth: the sign-in gate ----
# The auth service's base URL from the Neon Console, e.g.
# https://<project>.neon.tech/auth — no trailing slash. `auth.jwks_url()`
# derives the key set from it; there is deliberately no second URL to set.
NEON_AUTH_URL=
#
# Whether /api/* actually requires a verified session. Defaults false, and the
# default is the honest one: the whole app works without a credential, exactly
# like MAIL_TRANSPORT=log.
#
# ⚠️ Turning this on puts a third party in front of a flood map. `auth.verify`
# fails CLOSED, so a Neon Auth outage is an outage of the instrument, not just
# of the account. The basemap is ~1,400 committed coordinates so the drawing
# survives somebody else's bad day — this setting is what trades that away.
# `/api/healthz` reports `auth_required` so a deploy cannot be wrong about it
# silently.
REQUIRE_AUTH=false
#
# ⚠️ THE BROWSER NEEDS THE SAME URL AND DOES NOT READ IT FROM HERE.
# The UI is a static export, so its copy is baked in at BUILD time:
#
#   cd web && NEXT_PUBLIC_NEON_AUTH_URL=https://…/auth npm run prod:local
#   docker build --build-arg NEXT_PUBLIC_NEON_AUTH_URL=https://…/auth .
#
# Two variables, one value, two mechanisms, and nothing checks that they agree.
# Setting only NEON_AUTH_URL gives you an API that gates correctly and a UI
# that can never sign anybody in — with no error naming the cause.

# ---- Neon control API: hand the compute back when the run is done ----
# Neon bills for the compute being AWAKE, not for queries. `poll window` does
# about 25 seconds of work every 15 minutes, and then the compute idles for the
# whole `suspend_timeout_seconds` before scaling to zero — a minimum of 300s on
# the Launch plan, measured by asking for 60/120/180 and being refused. That
# tail, not the queries, is the bill.
#
# With these set, a scheduled run that finds the city QUIET asks Neon to
# suspend immediately: roughly 36% duty cycle becomes roughly 3%.
#
# ⚠️ BOTH EMPTY MEANS OFF, and off is a perfectly good deployment — the compute
# simply times out on its own, exactly as it did before this existed. Nothing
# on the alerting or display path reads these; see waterline/neon.py.
#
# ⚠️ THERE IS NO ENDPOINT SETTING, deliberately. The compute is derived from
# DATABASE_URL's host, because a separately configured endpoint is one deploy
# away from suspending production from a process pointed at a dev branch.
#
# ⚠️ This key can stop a database. Scope it to the one project.
NEON_API_KEY=
NEON_PROJECT_ID=

# ---- FloodNet ----
# Depth comes from FloodNet's public GraphQL API. No auth, no key, nothing to
# request:  https://api.floodnet.nyc/v1/graphql
# Leave this blank to use it. Set it only to point at a mirror or local cache.
FLOODNET_API_BASE=

# Socrata (no key needed for light use; an app token raises the rate limit)
SOCRATA_APP_TOKEN=
# Sensor deployment metadata — confirmed dataset id
FLOODNET_SENSORS_DATASET=kb2e-tjy3

# ⚠️ `config.py` is pydantic-settings over env, so an unknown key in your `.env`
# is IGNORED rather than rejected. A typo here is silent — the setting keeps its
# default and nothing anywhere says so. Check the field name against
# `waterline/config.py` before assuming a value took.

# ---- misc ----
# Comma-separated DOT camera ids to watch. This is the full GOLD tier: every
# camera with a FloodNet sensor within 100m, which is the same threshold
# `cameras.GOLD_PAIR_M` uses — the distance at which a camera and a sensor are
# demonstrably at the same intersection.
#
# Regenerate rather than hand-edit. `poll bootstrap` recomputes the pairing and
# these ids come straight back out of it:
#
#   select camera_id from pairs where distance_m <= 100 order by distance_m
#
# Twenty-seven cameras do not fit in a serial tick — `poll._look` fans them out
# across FETCH_WORKERS. Read that docstring before adding more, and note that
# the silver tier (<=250m) is 131 cameras, which is a different problem.
#
#   6c4cf1a1    8m  South St @ Broad St
#   ed0f8bd4   12m  3 Ave @ Union St
#   f8e7c70d   16m  11 Ave @ 42 St
#   7a183d27   18m  Northern Blvd @ Bell Blvd
#   a67d1358   20m  Hylan Blvd @ Seaview Ave — Staten Island, TIDAL: the coastal story
#   ae2f7e1a   29m  WBB -17  SOR - 2  @ Delancey St/FDR
#   85d33af1   33m  Stillwell Ave @ Neptune Ave — Coney Island
#   053afe02   38m  Atlantic Ave @ Barclays Center
#   4048d465   40m  FDR Dr @ BPU Entrance
#   c75873dc   48m  FDR @ E 6 St — highway impassability
#   af741eca   50m  WBB-10 NIR-4 @ FDR RD
#   fcaf0a31   51m  WBB SIR - 1 @ Manhattan Anchorage
#   5f9ef54f   53m  WBB - 5 NOR-5 @ Delancey St North/FDR
#   7b0f1486   57m  Flushing Ave @ Navy St
#   d872e1a0   61m  BQE @ Queens Blvd
#   36d22d6d   66m  Victory Blvd @ Bay St
#   0ff541bf   71m  Father Capodanno Blvd @ Sands LN
#   2b06cd6d   77m  BQE @ BELT PKWY Ramp & 60 St
#   c5af3e42   77m  Jackson Ave @ Thomson Ave
#   41397b64   78m  Park Ave @ 79 St
#   15c0758b   82m  NB Cross Brx Expy-Webster Av Exit ramp @ E 174 St & Cater Av
#   ba3d9734   85m  AVE C @ 23 St — Alphabet City, filled marshland, floods notoriously
#   a4bb497d   89m  Madison Ave @ 79 St
#   6be5adfc   90m  West St @ Murray
#   88278063   96m  3 Ave @ 60 St
#   9bb33444   98m  7 AVE / ADAM CLAYTON POWELL BLVD@ 125 St
#   606916f2   99m  AVE C @ 18 St — same corridor as 23 St, so you watch water propagate
WATCH_CAMERAS=6c4cf1a1-0a5c-4d32-b502-e4f28fe609fd,ed0f8bd4-fe44-4f86-98a9-91f45b446200,f8e7c70d-bdcb-4394-b55c-d9bcef891fba,7a183d27-7c22-4014-ac9a-726efa472c79,a67d1358-ca36-4f9a-a432-056361f7c904,ae2f7e1a-e781-4d24-9434-12f4f4ef4f2b,85d33af1-a82c-499c-b303-a16c8c891fe6,053afe02-e1b3-4bea-9995-787e72c7fff4,4048d465-2272-446e-bccb-c49ea6d62bd3,c75873dc-16d0-4e9c-b5b5-1c6ede0b0b63,af741eca-a192-41be-890a-22c7ae7d159a,fcaf0a31-e2ec-4abe-815d-2623d5e7b87b,5f9ef54f-f3ac-4ce9-ad39-2e483467867a,7b0f1486-6c0c-4bd4-ac8b-800c4bf2176e,d872e1a0-8c5f-47da-9469-bf40a3673ade,36d22d6d-bffd-4466-8a9c-9c78a1bb9021,0ff541bf-1be1-4bbf-88c5-3a570541e7d2,2b06cd6d-e698-4c1a-b306-6827fb19ced7,c5af3e42-bb95-4aa3-a9d1-2d8071412dab,41397b64-d035-4b41-a03e-170fe4103d89,15c0758b-5c9a-4841-8514-c04bc7320c70,ba3d9734-3871-4d49-b46b-88d88dd96e71,a4bb497d-7e15-47c4-9787-374b013efbbe,6be5adfc-1912-4811-9a04-01c8866280bb,88278063-8891-4144-9295-f5dc9a94d2ea,9bb33444-d2ec-47bd-952a-174f87013736,606916f2-cd00-4893-9d2b-4c9f9d6d974f
# LIVE or REPLAY
MODE=LIVE
# For REPLAY mode: ISO timestamp to start the replay clock at
REPLAY_START=

# ---- the sensor watch --------------------------------------------------
# NOTHING IS SENT until MAIL_TRANSPORT is "smtp" AND SMTP_HOST is set. The
# default renders every message, logs it in full, and marks the outbox row
# `skipped` — so the whole path is exercisable with no provider and no
# credential. That is deliberate: a credential is the only thing missing.
#
# ⚠️ Those two conditions are `mail.transport_delivers()`, which rides on
# /healthz as `mail_delivers`. With this at `log` the watch panel's confirm
# face says "No email was sent" instead of "check that address", so nobody is
# pointed at an inbox nothing was sent to. A fresh deploy reporting
# `mail_delivers: false` is correct, not broken.
#
# ⚠️ **RESEND IS THE WORKED EXAMPLE AND IT NEEDS NO CODE.** `mail._send` is
# stdlib `smtplib.SMTP` + `starttls()` + `login()`, which is exactly Resend's
# 587 shape, so the existing `smtp` transport carries it:
#
#   MAIL_TRANSPORT=smtp
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASSWORD=re_…
#   SMTP_FROM=Fluud <fluud@your-verified-domain>
#   SMTP_STARTTLS=true
#
# ⚠️ **587, never 465.** `_send` calls `starttls()` on a plain `smtplib.SMTP`;
# implicit TLS on 465 needs `SMTP_SSL` and there is no such branch.
#
# ⚠️ **SMTP_FROM must be on a domain VERIFIED with the provider**, which means
# publishing MX/SPF/DKIM in a zone whose DNS is ours. A platform-assigned
# hostname like `<app>.up.railway.app` **cannot be one** — that zone is the
# host's. An unverified sender comes back `SMTPSenderRefused`, which
# `mail.deliver` marks `failed`, and `db.prune_outbox` never deletes a `failed`
# row, so the evidence stays.
#
# ⚠️ **"Verified" means THAT EXACT DOMAIN, not the tree under it.** Verifying
# `example.com` does not authorise `mail.example.com` — that is a separate entry
# the provider has never seen, and a subdomain sender against a verified apex is
# refused exactly like an unrelated one.
#
# ⚠️ **Open tracking and click tracking must both be OFF.** Click tracking
# rewrites every link through the provider's redirector and records who pressed
# it — and these links carry the confirm and manage tokens, so it would put a
# bearer credential through a third party's URL rewriter. See the no-tracking
# rule in CLAUDE.md and the plain-text argument at `mail._send`.
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# ⚠️ A plain environment variable, in whatever host runs the container. There
# is no secret-manager integration anywhere in this repo, so treat it as
# readable by anybody who can read the service's configuration. Know that
# before putting a real credential here.
SMTP_PASSWORD=
SMTP_FROM=
# ⚠️ Defaults to true, and an EMPTY value does NOT turn it off — pydantic
# re-applies the default for a key that arrives empty. Write `false`.
SMTP_STARTTLS=true
SMTP_TIMEOUT=10

# The absolute origin the confirm and manage links point at, no trailing slash.
# ⚠️ Unset, a subscription can be created and can never be confirmed. `poll
# probe` warns about exactly this.
#
# ⚠️ **This is NOT the sending domain and the two must not be conflated.** The
# sending domain only has to be a zone whose DNS is ours; this is the origin
# serving the app, because it is where a reader who clicks lands. The links
# point at `<base>/watch/?confirm=…` and `<base>/watch/?watch=…` — `/watch/` and
# never `/map/`, which is behind the session gate.
PUBLIC_BASE_URL=

# How many instruments one address may watch, and how many addresses exist at
# all. Both are blast-radius bounds, not capacity planning.
WATCH_MAX_SENSORS=10
WATCH_MAX_SUBSCRIBERS=500

